---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 1rem;
    scroll-behavior: smooth;

    li {
      flex: 0 0 40%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      align-self: start;
      border-radius: 10px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      background: #ebebeb;
      color: #595566;

      h3 {
        font-weight: 700;
        font-size: 1.5625rem;
      }
    }
  }
</style>
