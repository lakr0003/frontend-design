---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  /* hjemmelavet men virker */
  /* ul {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 1rem;
    scroll-behavior: smooth;

    li {
      flex: 0 0 40%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      align-self: start;
      border-radius: 10px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      background: #ebebeb;
      color: #595566;

      h3 {
        font-weight: 700;
        font-size: 1.5625rem;
      }
    }
  } */

  /*fra timen*/
  ul {
    list-style: none;

    padding-block: 0;

    --scroll-padding: max(1rem, 50% - var(--content-width) / 2);
    --card-width: 400px;

    display: flex;
    gap: var(--card-gap);
    align-items: start;

    /* overflow-inline: auto; */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--scroll-padding); /* 1rem = minimum værdi - */
    scroll-padding-inline: var(--scroll-padding); /* gør så padding tæller med i scroll */

    li {
      flex: 1 0 var(--card-width);
      scroll-snap-align: start;
      background: var(--card-background);
      color: var(--card-text-color);
      padding: var(--card-padding);
      border-radius: var(--card-border-radius);
    }
  }
</style>
